[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/ui/survival_hud.tscn" id="2"]
[sub_resource type="StyleBoxFlat" id="panel"]
bg_color = Color(0.04, 0.08, 0.08, 0.80)
content_margin_left = 14.0
content_margin_right = 14.0
content_margin_top = 10.0
content_margin_bottom = 10.0
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_left = 8
corner_radius_bottom_right = 8

[sub_resource type="StyleBoxFlat" id="health_fill"]
