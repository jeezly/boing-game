corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_left = 5
corner_radius_bottom_right = 5

[sub_resource type="StyleBoxFlat" id="health_track"]
bg_color = Color(0.13, 0.20, 0.17, 1)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_left = 5
corner_radius_bottom_right = 5

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1")

[node name="Screen" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="health_panel" type="PanelContainer" parent="Screen"]
offset_left = 16.0
offset_top = 16.0
offset_right = 236.0
offset_bottom = 156.0
mouse_filter = 2
theme_override_styles/panel = SubResource("panel")

[node name="layout" type="VBoxContainer" parent="Screen/health_panel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 5

[node name="mode" type="Label" parent="Screen/health_panel/layout"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 14
text = "FIRST PERSON"


[node name="health_label" type="Label" parent="Screen/health_panel/layout"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 20
text = "HP 100 / 100"


[node name="health_bar" type="ProgressBar" parent="Screen/health_panel/layout"]
layout_mode = 2
custom_minimum_size = Vector2(0, 12)
mouse_filter = 2
value = 100.0
show_percentage = false
theme_override_styles/fill = SubResource("health_fill")
theme_override_styles/background = SubResource("health_track")

[node name="lives" type="Label" parent="Screen/health_panel/layout"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 20
text = "VIDAS ×3"
theme_override_colors/font_color = Color(1, 0.80, 0.31, 1)

[node name="protection" type="Label" parent="Screen/health_panel/layout"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 13
text = "PROTECCIÓN ACTIVA"
visible = false
theme_override_colors/font_color = Color(0.45, 1, 0.75, 1)

[node name="weapon_panel" type="PanelContainer" parent="Screen"]
